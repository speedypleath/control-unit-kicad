# KiCad backup files
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
*.000
*.001
*.002

# KiCad autosave
_autosave-*

# KiCad local project settings (personal preferences)
*.kicad_prl

# KiCad footprint cache
fp-info-cache

# KiCad 6+ rolling backups directory
*-backups/

# KiCad lock files
*.lck

# KiCad local file history (its own embedded git repo)
.history/

# macOS
.DS_Store

# Unzipped gerber/drill output — project/haptic-console-control-unit-gerbers.zip
# is the tracked deliverable, this directory is regenerated from it
project/gerbers/

# DRC/ERC reports — regenerated on demand by `kicad-cli pcb drc`
*-drc.rpt
*-erc.rpt

# Disposable scratch board used to verify jumper-wire placement before
# touching a real board (see docs/perfboard-wiring-regeneration.md)
test_board.kicad_pcb
test_board.kicad_pro

# Python bytecode from scripts/ and libraries/wire_models/
__pycache__/
